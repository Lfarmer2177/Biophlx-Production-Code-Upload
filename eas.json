{
  "cli": {
    "version": ">= 16.18.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal"
    },
    "production": {
      "autoIncrement": true
    },
    "testflight": {
      "distribution": "store",
      "autoIncrement": true,
      "env": {
        "BIOPHLX_TESTFLIGHT_VARIANT": "proposed-app-current-firmware",
        "EXPO_PUBLIC_ENABLE_OTA_PILOT": "false"
      }
    }
  },
  "submit": {
    "production": {},
    "testflight": {
      "ios": {
        "appleTeamId": "5F7CG99WV8",
        "appName": "BIOPHLX Proposed",
        "sku": "BIOPHLX-PROPOSEDCURRENT-TEST",
        "language": "en-US"
      }
    }
  }
}
